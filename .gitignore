# =========================================================================
# Android Kotlin Project .gitignore Template
# =========================================================================

# Gradle files and cache
.gradle/
build/
/*/build
/*/out
.kotlin/

# Local configuration file (contains your local Android SDK path, etc.)

# Android Studio / IntelliJ IDE files
.idea/workspace.xml
.idea/tasks.xml
.idea/gradle.xml
.idea/assetWizardSettings.xml
.idea/dictionaries
.idea/libraries
.idea/caches
.idea/navEditor.xml
misc.xml
deploymentTargetDropDown.xml
render.experimental.xml

# Built application outputs (Keep these out of version control)
*.apk
*.ap_
*.aab
*.dex
*.class
output-metadata.json

# Android Studio profiling and native build outputs
captures/
.externalNativeBuild/
.cxx/
*.hprof

# Log Files
*.log

# Sensitive Credentials (DO NOT COMMIT YOUR KEYSTORES!)
*.jks
*.keystore

# Google Services config file (Uncomment if you use different files for flavor environments)
# google-services.json

# OS specific files
Thumbs.db

.idea/deploymentTargetSelector.xml
