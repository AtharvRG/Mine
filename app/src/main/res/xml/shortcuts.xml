<?xml version="1.0" encoding="utf-8"?>
<!-- Blueprint 50 §3.14 / 52 §12: the launcher shortcut. It opens the chat composer focused,
     so one long-press on the launcher icon is a capture entry point with no navigation. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="new_note"
        android:enabled="true"
        android:icon="@drawable/ic_capture_reply"
        android:shortcutShortLabel="@string/shortcut_new_note_short"
        android:shortcutLongLabel="@string/shortcut_new_note_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.anchor.mine"
            android:targetClass="com.anchor.mine.MainActivity" />
        <categories android:name="android.shortcut.conversation" />
    </shortcut>
</shortcuts>
