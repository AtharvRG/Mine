<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <application
        android:name=".MineApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="Mine"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Mine">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Mine">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Blueprint 50 §3.14 / 52 §12: the launcher shortcut. singleTop + onNewIntent
                 keeps an open chat in place instead of remounting it under the user. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <receiver android:name=".alarms.AlarmReceiver" android:exported="false" />
        <!-- Blueprint 50 §3.14: inline reply on a reminder notification. Not exported: the
             PendingIntent that targets it is created by this app and is the only caller. -->
        <receiver android:name=".capture.QuickCaptureReceiver" android:exported="false" />
        <receiver android:name=".quotes.QuoteAlarmReceiver" android:exported="false" />
        <receiver android:name=".alarms.BootReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <!-- H-03 (R-03): self-sent retry after storage failed at boot. -->
                <action android:name="com.anchor.mine.alarms.ACTION_STORAGE_RETRY" />
                <!-- H-02 (R-02): periodic sweep so a miss is reported without the app opening. -->
                <action android:name="com.anchor.mine.alarms.ACTION_SWEEP" />
            </intent-filter>
        </receiver>
    </application>
</manifest>